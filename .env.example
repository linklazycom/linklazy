# ──────────────────────────────────────────────────────────────
# LinkLazy — environment variables
# Copy to .env.local for local dev. On Vercel: Settings → Environment Variables.
# NEVER commit real values.
# ──────────────────────────────────────────────────────────────

# ── Supabase (required) ───────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses RLS — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ── Site (required) ───────────────────────────────────────────
# Production: https://www.linklazy.com  (used for callbacks, sitemap, emails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Any long random string. Vercel sends it as "Authorization: Bearer <CRON_SECRET>" to /api/cron/*
CRON_SECRET=

# ── bKash (tokenized checkout) ────────────────────────────────
# sandbox: https://tokenized.sandbox.bka.sh/v1.2.0-beta   live: https://tokenized.pay.bka.sh/v1.2.0-beta
BKASH_BASE_URL=
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=

# ── PayPal ────────────────────────────────────────────────────
# sandbox: https://api-m.sandbox.paypal.com   live: https://api-m.paypal.com
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# ── Email via Resend (without these, emails are silently skipped) ──
RESEND_API_KEY=
# e.g. LinkLazy <hello@linklazy.com> — the domain must be verified in Resend
EMAIL_FROM=

# ── Ahrefs (Domain Rating checks) ─────────────────────────────
# Free key: https://app.ahrefs.com/account/api-keys
AHREFS_API_KEY=

# ── Images for blog covers (optional) ─────────────────────────
PEXELS_API_KEY=

# ── AI niche detection (optional — each is a separate "vote"; set any/all) ──
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# --- Batch 6: API Providers (admin-managed AI keys) ---
# Master secret used to encrypt API keys that an admin saves in the database.
# Use a long random string (32+ characters). Keep it only here (Vercel env), never in the database.
# If you change it later, previously saved provider keys become unreadable and must be re-entered.
PROVIDER_KEY_ENCRYPTION_SECRET=
